# Copy to .streamlit/secrets.toml (git-ignored) or paste into
# Streamlit Community Cloud -> App settings -> Secrets. Every entry is optional.

# Churn Copilot: enables free-form answers from Claude. Without it the
# Copilot runs in offline FAQ mode.
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: model and effort for the Copilot (defaults shown).
COPILOT_MODEL = "claude-opus-5-5"
COPILOT_EFFORT = "medium"

# Optional: require a password once per session before showing the app.
# APP_PASSWORD = "choose-a-strong-passphrase"
